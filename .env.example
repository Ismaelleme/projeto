APP_ENV=demo
DEMO_MODE=true
PORT=3000
HOST=127.0.0.1
SESSION_TTL_MINUTES=480
SEED_DEMO_DATA=true
SERVE_WEB=true
LOGIN_RATE_LIMIT=20
LOG_LEVEL=info

# Opcional. Se ausente, a API usa data/controle-visitas.db na raiz do projeto.
# DATABASE_PATH=

# Opcional. Sem valor, um segredo efêmero é gerado a cada início e os hashes
# de CPF deixam de ser estáveis entre reinícios da demo.
CPF_HASH_SECRET=troque-por-um-segredo-local-com-32-bytes-ou-mais
